#include "xparameters.h"
#include "xil_io.h"
#include "xil_printf.h"
#include "sleep.h"

// ！！！请确保这里的宏定义名字与你 xparameters.h 中的完全一致 ！！！
// 如果找不到宏，也可以直接写死地址，例如：#define PACMAN_BASEADDR 0x44A00000
#define PACMAN_BASEADDR XPAR_PACMAN_AXI4_GRAPHICS_0_S00_AXI_BASEADDR

// 寄存器偏移量映射
#define REG_PACMAN_X 0  // slv_reg0
#define REG_PACMAN_Y 4  // slv_reg1 (AXI是字节寻址，每个寄存器4字节)

int main() {
    xil_printf("Pac-Man Graphics Engine Starting...\r\n");

    int x_pos = 320; // 初始在屏幕中央 (假设640x480)
    int y_pos = 240;
    int direction = 1; // 1代表向右，-1代表向左

    // 初始化 Y 坐标
    Xil_Out32(PACMAN_BASEADDR + REG_PACMAN_Y, y_pos);

    while (1) {
        // 简单的物理逻辑：碰到左右边缘反弹
        x_pos += direction * 3; // 每次移动 3 个像素

        if (x_pos >= 600) {
            direction = -1; // 撞右墙，回头
        } else if (x_pos <= 40) {
            direction = 1;  // 撞左墙，回头
        }

        // 将新的 X 坐标写入 AXI 硬件寄存器
        Xil_Out32(PACMAN_BASEADDR + REG_PACMAN_X, x_pos);

        // 简易帧率控制：延时约 16000 微秒 (约等于 60 FPS)
        usleep(16000);
    }

    return 0;
}
